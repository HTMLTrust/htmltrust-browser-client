{
  "name": "@htmltrust/browser-client",
  "version": "0.1.2",
  "description": "Reference implementation of the HTMLTrust client-side verification and trust policy evaluation. Browser- and Node-compatible TypeScript library.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@htmltrust/canonicalization": "^0.3.0"
  },
  "dependencies": {
    "@htmltrust/canonicalization": "https://github.com/HTMLTrust/htmltrust-canonicalization/archive/5e51040dcaaf50935e245702bdefbc18a1d542ce.tar.gz",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "keywords": [
    "htmltrust",
    "verification",
    "trust",
    "signed-content",
    "browser"
  ],
  "author": "Jason Grey <jason@jason-grey.com>",
  "license": "Apache-2.0",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTMLTrust/htmltrust-browser-client.git"
  },
  "bugs": {
    "url": "https://github.com/HTMLTrust/htmltrust-browser-client/issues"
  },
  "homepage": "https://github.com/HTMLTrust/htmltrust-browser-client#readme"
}
